    "resources": {
      "media": [
        {
          "menuIcon": true,
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png"
        },
        {
          "type": "font",
          "name": "AIMIGO_TITLE_18",
          "file": "fonts/RobotoMono-Medium.ttf"
        }
      ]
    }
  }
}