    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "ReqQuestion",
      "ResAnswer",
      "ResStatus",
      "AudioMeta",
      "AudioChunk",
      "AudioIndex",
      "AudioEnd",
      "Language",
      "Voice",
      "ApiKey",
      "Model"
