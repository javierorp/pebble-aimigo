    "uuid": "d51b3760-297b-405b-b2d8-4ecc7982670f",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
